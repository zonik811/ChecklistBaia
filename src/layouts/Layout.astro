---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Panel General', icon: '🏝️' },
  { href: '/requisitos', label: 'Requisitos Obligatorios', icon: '🛡️' },
  { href: '/protocolo-reserva', label: 'Protocolo de Reserva', icon: '📋' },
  { href: '/operadores', label: 'Operadores y Agencias', icon: '🤝' },
  { href: '/reglas-multas', label: 'Prohibiciones & Multas', icon: '⚠️' },
  { href: '/plantillas', label: 'Plantillas y Mensajes', icon: '✉️' },
];
---

<!doctype html>
<html lang="es" class="h-full bg-slate-50 text-slate-800 scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Manual Propietario Baia Kristal</title>
    <style>
      /* Prevenir overflow horizontal en todo el documento */
      *, *::before, *::after {
        box-sizing: border-box;
      }
      body {
        overflow-x: hidden;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col text-slate-800 font-sans antialiased relative overflow-x-hidden">
    
    <!-- FONDO DECORATIVO INMERSIVO -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
      <img 
        src="/imagen1.webp" 
        alt="Baia Kristal Cartagena" 
        class="w-full h-full object-cover object-center opacity-15 filter blur-[4px] scale-105" 
      />
      <div class="absolute inset-0 bg-gradient-to-b from-sky-50/95 via-white/95 to-amber-50/90 backdrop-blur-[1px]"></div>
    </div>

    <!-- Header responsive -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/95 border-b border-sky-100/90 shadow-sm shadow-sky-950/5 relative">
      <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
          
          <!-- Logo con onda de mar y sol -->
          <div class="flex items-center gap-2.5 sm:gap-3">
            <a href="/" class="flex items-center gap-2.5 group">
              <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl sm:rounded-2xl bg-gradient-to-tr from-cyan-500 via-sky-500 to-teal-400 flex items-center justify-center text-white font-black text-lg sm:text-xl shadow-md shadow-cyan-500/25 group-hover:scale-105 transition-all shrink-0">
                🌊
              </div>
              <div class="min-w-0">
                <span class="text-sm sm:text-base font-extrabold text-slate-900 tracking-tight block truncate">
                  Baia Kristal <span class="text-sky-600 font-bold">•</span> Baia Kabo
                </span>
                <span class="text-[11px] sm:text-xs text-sky-600 font-semibold tracking-wide block truncate">
                  Manual de Renta Turística
                </span>
              </div>
            </a>
          </div>

          <!-- Navegación desktop -->
          <nav class="hidden lg:flex items-center gap-1.5 bg-slate-100/80 p-1.5 rounded-2xl border border-slate-200/80">
            {navItems.map(item => {
              const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`px-3 py-2 rounded-xl text-xs xl:text-sm font-semibold transition-all flex items-center gap-1.5 ${
                    isActive
                      ? 'bg-gradient-to-r from-sky-500 to-cyan-500 text-white shadow-md shadow-sky-500/25'
                      : 'text-slate-600 hover:text-sky-700 hover:bg-white/80'
                  }`}
                >
                  <span class="text-sm">{item.icon}</span>
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>

          <!-- Botón Menú Móvil (Hamburger) -->
          <div class="flex items-center gap-2 lg:hidden">
            <button 
              id="mobile-menu-btn" 
              type="button" 
              class="p-2 rounded-xl bg-sky-50 border border-sky-200 text-slate-700 hover:text-sky-600 focus:outline-none flex items-center justify-center cursor-pointer"
              aria-label="Abrir menú de navegación"
            >
              <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
              <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Badge oficial en desktop -->
          <div class="hidden xl:flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-500/10 text-amber-700 border border-amber-500/30">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
              Reglamento Feb 2025
            </span>
          </div>
        </div>
      </div>

      <!-- Menú Desplegable Móvil (Drawer) -->
      <div id="mobile-menu-drawer" class="hidden lg:hidden border-t border-sky-100 bg-white/98 backdrop-blur-lg px-4 py-3 shadow-xl space-y-1">
        {navItems.map(item => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center gap-2.5 ${
                isActive
                  ? 'bg-sky-500 text-white shadow-sm'
                  : 'text-slate-700 hover:bg-sky-50 active:bg-sky-100'
              }`}
            >
              <span class="text-base">{item.icon}</span>
              <span>{item.label}</span>
            </a>
          );
        })}
      </div>
    </header>

    <!-- Subheader con luz de playa -->
    {title && (
      <div class="relative bg-gradient-to-r from-sky-50 via-white to-amber-50/50 border-b border-sky-100 py-6 sm:py-8">
        <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 relative z-10">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 sm:gap-4">
            <div>
              <div class="flex items-center gap-2 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-sky-700 mb-1">
                <span>Cartagena</span>
                <span>•</span>
                <span>Complejo Crystal Lagoons</span>
              </div>
              <h1 class="text-xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-tight">
                {title}
              </h1>
              {subtitle && <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-3xl leading-relaxed">{subtitle}</p>}
            </div>
            <div class="text-xs text-sky-900 bg-white border border-sky-200/80 rounded-2xl p-2.5 sm:p-3 shadow-sm flex items-center gap-2.5 self-start md:self-auto shrink-0">
              <span class="text-xl sm:text-2xl">📖</span>
              <div>
                <span class="font-bold block text-slate-900 text-xs">Reglamento Oficial</span>
                <span class="text-[11px] text-slate-500">Agrupación Baia Kristal</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-3.5 sm:px-6 lg:px-8 py-6 sm:py-10 relative z-10">
      <slot />
    </main>

    <!-- Footer responsivo -->
    <footer class="mt-auto border-t border-sky-200/80 bg-white/95 py-6 sm:py-8 text-xs text-slate-500 relative z-10">
      <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 text-center sm:text-left">
        <div class="flex items-center gap-2.5 justify-center sm:justify-start">
          <div class="w-7 h-7 rounded-lg bg-sky-100 text-sky-600 flex items-center justify-center font-bold text-sm shrink-0">
            🌴
          </div>
          <div>
            <p class="font-bold text-slate-800 text-xs">Manual de Vivienda Turística para Propietarios</p>
            <p class="text-[11px] text-slate-500">Baia Kabo • Agrupación Baia Kristal, Cartagena</p>
          </div>
        </div>
        <div class="text-center sm:text-right">
          <p class="text-[11px] text-slate-700 font-semibold">RPH Escrituras 5290 / 1186 / 2159</p>
          <p class="text-[11px] text-sky-600 font-medium">Reglamento vigente desde febrero de 2025</p>
        </div>
      </div>
    </footer>

    <!-- Script de navegación móvil -->
    <script is:inline>
      const btn = document.getElementById('mobile-menu-btn');
      const drawer = document.getElementById('mobile-menu-drawer');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      if (btn && drawer && iconOpen && iconClose) {
        btn.addEventListener('click', () => {
          const isHidden = drawer.classList.contains('hidden');
          if (isHidden) {
            drawer.classList.remove('hidden');
            iconOpen.classList.add('hidden');
            iconClose.classList.remove('hidden');
          } else {
            drawer.classList.add('hidden');
            iconOpen.classList.remove('hidden');
            iconClose.classList.add('hidden');
          }
        });
      }
    </script>
  </body>
</html>
