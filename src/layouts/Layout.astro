---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Panel General', icon: '🏝️' },
  { href: '/requisitos', label: 'Requisitos Obligatorios', icon: '🛡️' },
  { href: '/protocolo-reserva', label: 'Protocolo de Reserva', icon: '📋' },
  { href: '/operadores', label: 'Operadores y Agencias', icon: '🤝' },
  { href: '/reglas-multas', label: 'Prohibiciones & Multas', icon: '⚠️' },
  { href: '/plantillas', label: 'Plantillas y Mensajes', icon: '✉️' },
];
---

<!doctype html>
<html lang="es" class="h-full bg-slate-50 text-slate-800 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Manual Propietario Baia Kristal</title>
  </head>
  <body class="min-h-full flex flex-col text-slate-800 font-sans antialiased relative">
    
    <!-- FONDO DECORATIVO INMERSIVO CON IMAGEN1.WEBP -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
      <img 
        src="/imagen1.webp" 
        alt="Baia Kristal Cartagena" 
        class="w-full h-full object-cover object-center opacity-25 filter blur-[3px] scale-105" 
      />
      <!-- Capa de brillo y calidez caribeña -->
      <div class="absolute inset-0 bg-gradient-to-b from-sky-50/90 via-white/92 to-amber-50/90 backdrop-blur-[2px]"></div>
    </div>

    <!-- Header costero y luminoso -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/90 border-b border-sky-100/90 shadow-sm shadow-sky-950/5 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Logo con onda de mar y sol -->
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-3 group">
              <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-cyan-500 via-sky-500 to-teal-400 flex items-center justify-center text-white font-black text-xl shadow-md shadow-cyan-500/25 group-hover:scale-105 group-hover:rotate-1 transition-all">
                🌊
              </div>
              <div>
                <span class="text-base font-extrabold text-slate-900 tracking-tight block">
                  Baia Kristal <span class="text-sky-600 font-bold">•</span> Baia Kabo
                </span>
                <span class="text-xs text-sky-600 font-semibold tracking-wide">
                  Manual de Renta Turística para Propietarios
                </span>
              </div>
            </a>
          </div>

          <!-- Navegación desktop estilo balneario premium -->
          <nav class="hidden md:flex items-center gap-1.5 bg-slate-100/80 p-1.5 rounded-2xl border border-slate-200/80">
            {navItems.map(item => {
              const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`px-3.5 py-2 rounded-xl text-xs lg:text-sm font-semibold transition-all flex items-center gap-1.5 ${
                    isActive
                      ? 'bg-gradient-to-r from-sky-500 to-cyan-500 text-white shadow-md shadow-sky-500/25'
                      : 'text-slate-600 hover:text-sky-700 hover:bg-white/80'
                  }`}
                >
                  <span class="text-sm">{item.icon}</span>
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>

          <!-- Badge oficial -->
          <div class="hidden lg:flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-500/10 text-amber-700 border border-amber-500/30">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
              Reglamento Feb 2025
            </span>
          </div>
        </div>
      </div>

      <!-- Navegación móvil scrollable -->
      <div class="md:hidden flex overflow-x-auto px-4 py-2 gap-2 border-t border-sky-100 bg-sky-50/50">
        {navItems.map(item => {
          const isActive = currentPath === item.href;
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded-xl text-xs whitespace-nowrap font-semibold flex items-center gap-1.5 ${
                isActive
                  ? 'bg-sky-500 text-white shadow-sm'
                  : 'text-slate-600 hover:bg-white bg-white/70 border border-slate-200/60'
              }`}
            >
              <span>{item.icon}</span>
              <span>{item.label}</span>
            </a>
          );
        })}
      </div>
    </header>

    <!-- Subheader limpio con fondo costero suave -->
    {title && (
      <div class="relative bg-gradient-to-r from-sky-50 via-white to-amber-50/50 border-b border-sky-100 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-sky-700 mb-1">
                <span>Cartagena de Indias</span>
                <span>•</span>
                <span>Complejo Crystal Lagoons</span>
              </div>
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">
                {title}
              </h1>
              {subtitle && <p class="text-sm sm:text-base text-slate-600 mt-1 max-w-3xl leading-relaxed">{subtitle}</p>}
            </div>
            <div class="text-xs text-sky-900 bg-white border border-sky-200/80 rounded-2xl p-3 shadow-sm flex items-center gap-2.5 self-start md:self-auto">
              <span class="text-2xl">📖</span>
              <div>
                <span class="font-bold block text-slate-900">Reglamento Oficial</span>
                <span class="text-slate-500">Agrupación Baia Kristal</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 relative z-10">
      <slot />
    </main>

    <!-- Footer fresco estilo caribeño -->
    <footer class="mt-auto border-t border-sky-200/80 bg-white/90 py-8 text-xs text-slate-500 relative z-10 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-sky-100 text-sky-600 flex items-center justify-center font-bold text-base">
            🌴
          </div>
          <div>
            <p class="font-bold text-slate-800">Manual de Cumplimiento de Vivienda Turística para Propietarios</p>
            <p class="text-slate-500">Conjunto Residencial Baia Kabo • Agrupación Baia Kristal, Cartagena</p>
          </div>
        </div>
        <div class="text-center sm:text-right">
          <p class="font-semibold text-slate-700">RPH Escritura Pública 5290 / 1186 / 2159</p>
          <p class="text-sky-600 font-medium">Actualizado con el Reglamento vigente de febrero de 2025</p>
        </div>
      </div>
    </footer>
  </body>
</html>
