---
interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
}

const { title, description, lang } = Astro.props;
const otherLang = lang === 'es' ? 'en' : 'es';
const otherLangUrl = lang === 'es' ? '/en/' : '/';

const navLabels = {
  es: { wifi: 'WiFi', schedule: 'Llegada', rules: 'Normas', lagoon: 'Laguna', nearby: 'Cerca', contact: 'Contacto' },
  en: { wifi: 'WiFi', schedule: 'Schedule', rules: 'Rules', lagoon: 'Lagoon', nearby: 'Nearby', contact: 'Contact' }
}[lang];
---

<!doctype html>
<html lang={lang} class="scroll-smooth bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col bg-gradient-to-b from-slate-950 via-slate-900 to-[#031d33] text-slate-200 antialiased selection:bg-cyan-500 selection:text-slate-950">
    
    <!-- Header Superior -->
    <header class="sticky top-0 z-50 backdrop-blur-lg bg-slate-950/80 border-b border-cyan-500/20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        
        <!-- Logo / Marca -->
        <a href={lang === 'es' ? '/' : '/en/'} class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-teal-300 flex items-center justify-center text-slate-950 font-black text-lg shadow-lg shadow-cyan-500/30 group-hover:scale-105 transition-transform">
            🌴
          </div>
          <div>
            <span class="text-sm font-bold text-white tracking-wide block">Baia Kabo Retreat</span>
            <span class="text-[10px] text-cyan-400 font-medium tracking-wider uppercase">Cartagena de Indias</span>
          </div>
        </a>

        <!-- Navegación desktop -->
        <nav class="hidden md:flex items-center gap-4 text-xs font-medium text-slate-300">
          <a href="#wifi" class="hover:text-cyan-400 transition-colors">{navLabels.wifi}</a>
          <a href="#schedule" class="hover:text-cyan-400 transition-colors">{navLabels.schedule}</a>
          <a href="#rules" class="hover:text-cyan-400 transition-colors">{navLabels.rules}</a>
          <a href="#lagoon" class="hover:text-cyan-400 transition-colors">{navLabels.lagoon}</a>
          <a href="#nearby" class="hover:text-cyan-400 transition-colors">{navLabels.nearby}</a>
          <a href="#emergency" class="hover:text-cyan-400 transition-colors">{navLabels.contact}</a>
        </nav>

        <!-- Selector de Idioma & Botón Imprimir -->
        <div class="flex items-center gap-2">
          <a
            href="/print"
            class="hidden sm:flex px-3 py-1.5 rounded-full text-xs font-bold border border-slate-700 bg-slate-900/80 text-slate-300 hover:text-white hover:border-slate-500 transition-all items-center gap-1.5 shadow-sm"
            title="Ver tarjeta imprimible para el apartamento"
          >
            <span>🖨️</span> Imprimir
          </a>
          <a
            href={otherLangUrl}
            class="px-3 py-1.5 rounded-full text-xs font-bold border border-cyan-500/40 bg-cyan-950/40 text-cyan-300 hover:bg-cyan-500 hover:text-slate-950 transition-all flex items-center gap-1.5 shadow-sm"
            title={lang === 'es' ? 'Switch to English' : 'Cambiar a Español'}
          >
            <span>{lang === 'es' ? '🇺🇸 EN' : '🇨🇴 ES'}</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-12 sm:space-y-16">
      <slot />
    </main>

    <!-- Barra flotante móvil para WiFi y Contacto -->
    <div class="md:hidden fixed bottom-4 inset-x-4 z-40 flex items-center justify-center gap-3">
      <a 
        href="#wifi" 
        class="flex-1 py-3 px-4 rounded-2xl bg-cyan-500 text-slate-950 font-bold text-xs text-center shadow-lg shadow-cyan-500/40 flex items-center justify-center gap-2"
      >
        <span>📶</span> {navLabels.wifi}
      </a>
      <a 
        href="#emergency" 
        class="flex-1 py-3 px-4 rounded-2xl bg-slate-800/90 backdrop-blur-md border border-slate-700 text-white font-bold text-xs text-center shadow-lg flex items-center justify-center gap-2"
      >
        <span>📞</span> {navLabels.contact}
      </a>
    </div>

    <!-- Footer -->
    <footer class="mt-auto border-t border-slate-800/80 bg-slate-950/90 py-8 text-xs text-slate-500 text-center">
      <div class="max-w-5xl mx-auto px-4 space-y-2">
        <p class="font-medium text-slate-400">Conjunto Residencial Baia Kabo • Agrupación Baia Kristal</p>
        <p class="text-[11px] text-slate-600">Cartagena, Colombia — {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>
